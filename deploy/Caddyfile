{$DOMAIN} {
	encode zstd gzip

	# Всё проксируем в FastAPI: и статику, и /api (SSE-стриминг в том числе)
	reverse_proxy app:8000 {
		flush_interval -1   # мгновенная отдача SSE-чанков, без буферизации
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output stdout
		format console
	}
}
