# Копируйте в deploy/.env на сервере: cp .env.example deploy/.env
# В git НЕ коммитить реальные значения.

# Kimi API (https://platform.kimi.ai → API Keys)
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k3

# Секрет подписи сессионных кук — сгенерируйте: openssl rand -hex 32
SESSION_SECRET=

# Домен для Caddy (TLS выпустится автоматически)
DOMAIN=finmodel.example.com
